# Separate multiple allowed origins with commas.
FRONTEND_ORIGINS=http://localhost:3000

# Defaults to backend/chat.db when omitted.
DATABASE_URL=sqlite:///./chat.db

# Secret used to sign JWTs. Use a long random value in shared or production environments.
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Use false for localhost over HTTP and true for production over HTTPS.
AUTH_COOKIE_SECURE=false
